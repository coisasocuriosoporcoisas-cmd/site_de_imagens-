{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "galeria-lume",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/admin*", "/pin/*", "/entrar-8f3k2x", "/robots.txt", "/sitemap.xml"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "galeria-lume-db",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "galeria-lume-images"
    }
  ],
  "vars": {
    "ADMIN_LOGIN_PATH": "/entrar-8f3k2x",
    "MAX_UPLOAD_MB": "10"
  }
}
