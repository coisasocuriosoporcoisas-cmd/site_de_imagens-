{
  "name": "galeria-lume",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "node --check worker/index.js && wrangler deploy --dry-run",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply galeria-lume-db --local",
    "db:remote": "wrangler d1 migrations apply galeria-lume-db --remote",
    "migrate:data": "node scripts/migrate-local-data.mjs",
    "lint": "biome lint worker public scripts",
    "test": "node --test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "wrangler": "^4.164.0"
  }
}
