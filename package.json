  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@opennextjs/cloudflare": "^1.20.17",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
